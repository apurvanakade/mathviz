//
// posts.qmd's listing template: one plain row per item. metadataAttrs()
// carries the categories Quarto's filter reads. Lines are not indented:
// Quarto reads the output as Markdown.
%>
<div class="list post-rows">
<% for (const item of items) { %>
<div class="post-row" <%= metadataAttrs(item) %>><a href="<%- item.path %>"><%= item.title %></a></div>
<% } %>
</div>
